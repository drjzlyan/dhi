package textbuf

import (
	"reflect"
	"strings"
	"testing"
)

const mk = "<<<<<<< HEAD\nours\n=======\ntheirs\n>>>>>>> feature\n"

func TestParseConflicts(t *testing.T) {
	tests := []struct {
		name string
		in   string
		want []Conflict
	}{
		{"plain", "a\n" + mk + "b", []Conflict{{Start: 1, Base: -1, Sep: 3, End: 5}}},
		{"diff3", "<<<<<<< HEAD\no\n||||||| base\nb\n=======\nt\n>>>>>>> x", []Conflict{{0, 2, 4, 6}}},
		{"two", mk + "mid\n" + mk, []Conflict{{0, -1, 2, 4}, {6, -1, 8, 10}}},
		{"crlf", strings.ReplaceAll(mk, "\n", "\r\n"), []Conflict{{0, -1, 2, 4}}},
		{"bare markers", "<<<<<<<\na\n=======\nb\n>>>>>>>", []Conflict{{0, -1, 2, 4}}},
		{"marker length 6 and 8 ignored", "<<<<<< HEAD\na\n======\nb\n>>>>>> x\n<<<<<<<< HEAD\na\n========\nb\n>>>>>>>> x", nil},
		{"mixed length inside", "<<<<<<< HEAD\na\n========\n=======\nb\n>>>>>>>> n\n>>>>>>> x", []Conflict{{0, -1, 3, 6}}},
		{"closed before separator is malformed", "<<<<<<< HEAD\na\n>>>>>>> x\n" + mk, []Conflict{{3, -1, 5, 7}}},
		{"unterminated", "<<<<<<< HEAD\na\n=======\nb", nil},
		{"nested-looking opener is content", "<<<<<<< a\n<<<<<<< b\nx\n=======\ny\n>>>>>>> c\n>>>>>>> d", []Conflict{{0, -1, 3, 5}}},
		{"stray separator alone", "title\n=======\ntext", nil},
		{"marker needs space after", "<<<<<<<x\n=======\n>>>>>>>x", nil},
		{"indented is text", " <<<<<<< a\n =======\n >>>>>>> b", nil},
	}
	for _, tc := range tests {
		got := ParseConflicts(strings.Split(tc.in, "\n"))
		if !reflect.DeepEqual(got, tc.want) {
			t.Errorf("%s: got %+v want %+v", tc.name, got, tc.want)
		}
	}
}

func TestConflictRegions(t *testing.T) {
	lines := strings.Split("x\n<<<<<<< a\no\n||||||| b\nbb\n=======\nt\n>>>>>>> c\ny", "\n")
	c := ParseConflicts(lines)[0]
	want := []ConflictRegion{RegionNone, RegionMarker, RegionOurs, RegionMarker, RegionBase,
		RegionMarker, RegionTheirs, RegionMarker, RegionNone}
	for i, w := range want {
		if got := c.Region(i); got != w {
			t.Errorf("line %d: got %v want %v", i, got, w)
		}
	}
}

func TestResolveChoices(t *testing.T) {
	d3 := strings.Split("<<<<<<< a\no1\no2\n||||||| b\nbase\n=======\nt1\n>>>>>>> c", "\n")
	c := ParseConflicts(d3)[0]
	for choice, want := range map[ConflictChoice][]string{
		KeepOurs: {"o1", "o2"}, KeepTheirs: {"t1"}, KeepBoth: {"o1", "o2", "t1"}, KeepBase: {"base"},
	} {
		got, ok := c.Resolve(d3, choice)
		if !ok || !reflect.DeepEqual(got, want) {
			t.Errorf("choice %d: got %v ok=%v want %v", choice, got, ok, want)
		}
	}
	plain := strings.Split(strings.TrimSuffix(mk, "\n"), "\n")
	if _, ok := ParseConflicts(plain)[0].Resolve(plain, KeepBase); ok {
		t.Error("base without a base section should be refused")
	}
	empty := strings.Split("<<<<<<< a\n=======\nt\n>>>>>>> b", "\n")
	if got, _ := ParseConflicts(empty)[0].Resolve(empty, KeepOurs); len(got) != 0 {
		t.Errorf("empty ours = %v", got)
	}
}

func conflictEditor() *Editor {
	return NewEditor("top\n" + mk + "mid\n<<<<<<< HEAD\no2\n||||||| base\nb2\n=======\nt2\n>>>>>>> f\nend")
}

func TestJumpConflicts(t *testing.T) {
	e := conflictEditor()
	feed(e, "]x")
	if got := e.Buffer().Cursor().Line; got != 1 || e.Message() != "conflict 1 of 2" {
		t.Fatalf("]x: line %d msg %q", got, e.Message())
	}
	feed(e, "]x")
	if e.Buffer().Cursor().Line != 7 {
		t.Fatalf("second ]x at %d", e.Buffer().Cursor().Line)
	}
	feed(e, "]x")
	if e.Buffer().Cursor().Line != 7 || e.Message() != "no more conflicts" {
		t.Fatalf("past the last: %d %q", e.Buffer().Cursor().Line, e.Message())
	}
	feed(e, "[x")
	if e.Buffer().Cursor().Line != 1 {
		t.Fatalf("[x at %d", e.Buffer().Cursor().Line)
	}
	feed(e, "G", "[x")
	if e.Buffer().Cursor().Line != 7 {
		t.Fatalf("[x from the end at %d", e.Buffer().Cursor().Line)
	}
	e.buf.SetCursor(Pos{})
	feed(e, "2", "]x") // a count steps that many conflicts
	if e.Buffer().Cursor().Line != 7 {
		t.Fatalf("2]x at %d", e.Buffer().Cursor().Line)
	}
}

func TestJumpWithOperatorPendingIsNoMotion(t *testing.T) {
	e := conflictEditor()
	before := e.Buffer().Text()
	feed(e, "d", "]x")
	if e.Buffer().Text() != before || e.Buffer().Cursor().Line != 0 {
		t.Fatal("d]x must not delete or move")
	}
	feed(e, "j") // the operator was dropped: j just moves
	if e.Buffer().Text() != before {
		t.Fatal("pending d leaked into the next key")
	}
}

func TestNoConflictsMessage(t *testing.T) {
	e := NewEditor("plain\n")
	feed(e, "]x")
	if e.Message() != "no merge conflicts in this file" {
		t.Fatal(e.Message())
	}
	typeKeys(e, ":conflict ours\n")
	if !strings.Contains(e.Message(), "not inside") {
		t.Fatal(e.Message())
	}
}

func TestConflictExAccept(t *testing.T) {
	rest := "mid\n<<<<<<< HEAD\no2\n||||||| base\nb2\n=======\nt2\n>>>>>>> f\nend"
	for arg, want := range map[string]string{
		"ours":   "top\nours\n" + rest,
		"theirs": "top\ntheirs\n" + rest,
		"both":   "top\nours\ntheirs\n" + rest,
	} {
		e := conflictEditor()
		feed(e, "j", "j") // inside the first block
		typeKeys(e, ":conflict "+arg+"\n")
		if got := e.Buffer().Text(); got != want {
			t.Errorf("%s:\n%s", arg, got)
		}
		if !strings.Contains(e.Message(), "1 left") || e.Buffer().Cursor().Line != 1 {
			t.Errorf("%s: msg %q cursor %v", arg, e.Message(), e.Buffer().Cursor())
		}
	}
	e := conflictEditor()
	e.buf.SetCursor(Pos{Line: 10})
	typeKeys(e, ":conflict base\n")
	if !strings.HasSuffix(e.Buffer().Text(), "mid\nb2\nend") {
		t.Fatalf("base:\n%s", e.Buffer().Text())
	}
}

func TestConflictBaseNeedsDiff3(t *testing.T) {
	e := conflictEditor()
	feed(e, "j")
	typeKeys(e, ":conflict base\n")
	if !strings.Contains(e.Message(), "no base section") || e.Buffer().Dirty() {
		t.Fatalf("msg %q dirty %v", e.Message(), e.Buffer().Dirty())
	}
}

func TestConflictAcceptIsOneUndoStep(t *testing.T) {
	e := conflictEditor()
	orig := e.Buffer().Text()
	feed(e, "j")
	typeKeys(e, ":conflict both\n")
	if e.Buffer().Text() == orig {
		t.Fatal("not resolved")
	}
	feed(e, "u")
	if e.Buffer().Text() != orig {
		t.Fatalf("one u should restore:\n%s", e.Buffer().Text())
	}
	if len(e.Conflicts()) != 2 {
		t.Fatal("conflicts cache stale after undo")
	}
}

func TestConflictLastResolvedSaysSo(t *testing.T) {
	e := NewEditor(mk)
	typeKeys(e, ":conflict theirs\n")
	if !strings.Contains(e.Message(), "none left") || len(e.Conflicts()) != 0 {
		t.Fatalf("msg %q", e.Message())
	}
	if e.ConflictRegionAt(0) != RegionNone {
		t.Fatal("region after resolve")
	}
}

func TestConflictUsageAndNextPrev(t *testing.T) {
	e := conflictEditor()
	typeKeys(e, ":conflict\n")
	if !strings.Contains(e.Message(), "usage") {
		t.Fatal(e.Message())
	}
	typeKeys(e, ":conflict next\n")
	if e.Buffer().Cursor().Line != 1 {
		t.Fatal("next")
	}
	typeKeys(e, ":conflict prev\n")
	if e.Message() != "no more conflicts" {
		t.Fatal(e.Message())
	}
}
